# 로컬 개발용. 복사해서 .env로 사용 (커밋 금지). 배포는 st.secrets 사용.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-001
LEARNER_ENABLED=false
# 판정 엔진: gemini(기본) | openai_compatible | rule
LLM_PROVIDER=
# openai_compatible일 때 (예: Ollama http://localhost:11434/v1)
LLM_BASE_URL=
LLM_MODEL=
LLM_EMBED_MODEL=
LLM_API_KEY=
# 한국은행 ECOS Open API 키 (로컬 감시 시장·외국인 순매수, scripts/fetch_ecos.py)
ECOS_API_KEY=
# 금융감독원 DART Open API 키 (로컬 감시 공시·신용 경고)
DART_API_KEY=
# 텔레그램 알림 (봇 토큰·채팅 ID, 둘 다 있어야 보낸다)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SEC EDGAR 요청 User-Agent (연락처 포함 필수, P1에서 사용)
SEC_USER_AGENT=
# 데이터 디렉터리 (기본: ./data)
ALPHA_DATA_DIR=
